# Production API example for future deployment planning only.
# This file is not enough to make the system production-ready.
# Use a secret manager or deployment environment variables for real values.

APP_NAME=Agua Sales API
APP_ENV=production
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://replace-with-prod-db-user:replace-with-prod-db-password@replace-with-prod-db-host:5432/replace-with-prod-db-name

AGENT_SIMULATION_TOKEN=replace-with-strong-production-agent-simulation-token

# Keep disabled until the public HTTPS webhook, signature validation,
# rate limiting, monitoring and operational procedures are ready.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-production-whatsapp-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-production-whatsapp-app-secret
