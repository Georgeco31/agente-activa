# Local API example.
# Copy values into apps/api/.env if running the API outside Docker Compose.
# Keep real .env files out of Git.

APP_NAME=Agua Sales API
APP_ENV=local
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agua_sales
POSTGRES_USER=replace-with-local-db-user
POSTGRES_PASSWORD=replace-with-local-db-password

DATABASE_URL=postgresql+psycopg://replace-with-local-db-user:replace-with-local-db-password@localhost:5432/agua_sales

AGENT_SIMULATION_TOKEN=replace-with-local-agent-simulation-token

WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-local-whatsapp-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-local-whatsapp-app-secret
